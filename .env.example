# Copy this file to `.env` and fill in your real key(s).
#
# The AI Assistant, executive summaries, recommendations, and prediction
# explanations are all optional -- the rest of the platform (upload,
# preprocessing, AutoML, predictions, dashboards) works fully without this.

# Active provider (services/llm_service.py) -- get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional secondary provider (services/providers/gemini_provider.py) -- only
# needed if you switch _ACTIVE_PROVIDER back to "gemini" in llm_service.py.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
